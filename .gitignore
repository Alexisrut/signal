# Ведущий слэш обязателен: без него шаблон совпадает с любой папкой `data`
# на любом уровне вложенности — и выбрасывает из репозитория public/js/data/,
# из-за чего клиент перестает собираться (падает импорт data/store.js).
/node_modules/
/data/

# Секреты почты и прочие локальные настройки. Шаблон — в .env.example.
.env
.env.local

# Промежуточные файлы записи туториала (кадры и временная база).
# Сам ролик tutorial/*.mp4 остается в репозитории.
/tutorial/frames/
/tutorial/data/
/tutorial/frames.txt

# Служебные файлы macOS.
.DS_Store

# Отметка предыдущей версии для отката (создаётся deploy.sh на сервере).
.deploy-previous

# Рабочие выгрузки помощника.
Claude outputs/

# Сборочный вывод генератора руководств. Готовые к выкладке файлы — в guides/.
/docs/guides/source/dist/
/docs/guides/source/out/
/docs/guides/guide-*.html
