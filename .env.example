# Шаблон настроек. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# Файл .env в .gitignore — секреты в репозиторий не попадают.

# --- Почта -------------------------------------------------------------------
# mail.ru: порт 465 (SSL). Для Яндекса — smtp.yandex.ru, для Gmail — smtp.gmail.com.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true

# Полный адрес ящика.
SMTP_USER=vis_group_auto@mail.ru

# ВАЖНО: это «пароль для внешних приложений» из настроек ящика,
# а не пароль, которым вы входите на сайт почты.
SMTP_PASS=

# Отправитель. Адрес обязан совпадать с SMTP_USER, иначе mail.ru отклонит письмо.
MAIL_FROM=Мониторинг сигналов <vis_group_auto@mail.ru>

# --- Приложение --------------------------------------------------------------
# Внешний адрес: подставляется в ссылки внутри писем (подтверждение почты,
# переход к карточке сигнала). В Codespaces — адрес проброшенного порта.
APP_URL=http://localhost:5175
PORT=5175

# --- Безопасность ------------------------------------------------------------
# Интерфейс, на котором слушает приложение. По умолчанию только петля: наружу
# оно смотрит через nginx, и порт не должен быть доступен в обход TLS.
# HOST=0.0.0.0 нужен, только если приложение живет в контейнере.
HOST=127.0.0.1

# Доверять X-Forwarded-For при определении адреса клиента. Включать ТОЛЬКО
# за обратным прокси и при закрытом снаружи порте приложения: иначе адрес
# подделывается заголовком, и ограничение частоты запросов обходится.
TRUST_PROXY=true

# ВАЖНО: флаг Secure у сессионной куки и заголовок HSTS включаются, когда
# APP_URL начинается с https:// — на боевом домене адрес должен быть https.

# --- Первый администратор ----------------------------------------------------
# Читаются ТОЛЬКО при первом запуске на пустой базе: пока в системе нет ни
# одного администратора, сервер заводит главного по этим значениям. Позже они
# ни на что не влияют — пароль меняется в разделе «Аккаунт».
# Без них создается демо-доступ admin/admin123, опубликованный в README.
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_EMAIL=admin@vis.ru
DEFAULT_ADMIN_PASSWORD=

# --- Данные ------------------------------------------------------------------
# Где лежат база, вложения и dev-инбокс. По умолчанию — папка data/ в проекте.
# На сервере вынесите за пределы репозитория, чтобы git pull не трогал данные.
# DATA_DIR=/var/lib/signal-monitor
